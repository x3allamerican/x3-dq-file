{
  "name": "@x3/dq-file",
  "version": "1.0.0",
  "description": "Check a driver qualification file against 49 CFR 391.51: missing, late, expiring and overdue items, next due dates, qualified-to-drive, retention and purge.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/fix-dts.mjs",
    "test": "node --test \"test/*.test.ts\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "dot",
    "fmcsa",
    "driver-qualification",
    "dq-file",
    "49-cfr-391",
    "mvr",
    "medical-card",
    "clearinghouse",
    "trucking",
    "fleet-safety"
  ],
  "author": "X3 Fleet Safety (https://x3fleetsafety.com)",
  "license": "MIT",
  "homepage": "https://github.com/x3allamerican/x3-dq-file#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x3allamerican/x3-dq-file.git"
  },
  "bugs": {
    "url": "https://github.com/x3allamerican/x3-dq-file/issues"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
